{
  "name": "crunch-editor",
  "version": "1.0.0",
  "description": "Crunch Python code editor with VS Code-style syntax highlighting, autocomplete, and local execution.",
  "author": "Crunch contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dipanshutadiyal-bit/crunch-editor.git"
  },
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "node server.js",
    "start": "electron .",
    "dist:win": "electron-builder --win portable",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.crunch.editor",
    "productName": "Crunch",
    "artifactName": "Crunch-${version}-Windows.${ext}",
    "files": [
      "app.js",
      "index.html",
      "styles.css",
      "server.js",
      "main.cjs",
      "preload.cjs",
      "app.config.ts",
      "python-modern-notes.md",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }]
    },
    "portable": {
      "requestExecutionLevel": "user"
    }
  }
}
